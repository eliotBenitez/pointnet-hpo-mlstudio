      "html": "<div class=\"ds-head\"><div><div class=\"ds-head-title\">ground_xyz</div><div class=\"ds-head-sub\">Грунт · xyz</div></div><span class=\"ds-chip ds-live\">В ЭФИРЕ</span><span style=\"flex:1\"></span><button class=\"ds-bb ds-bb-sec\">Копировать лог</button><button class=\"ds-bb ds-bb-stop\">Остановить</button></div>",
      "css": ".ds-head{display:flex;align-items:center;gap:16px;padding:16px 20px;border-radius:12px;background:rgba(138,90,43,.14);border:1px solid rgba(138,90,43,.4);color:#16181D;font-family:'Golos Text',sans-serif}.ds-head-title{font:700 34px/1.05 'PT Sans Narrow','PT Sans',sans-serif}.ds-head-sub{font-size:14px}.ds-chip{display:inline-block;padding:2px 10px;border-radius:9999px;font:700 12px 'Golos Text',sans-serif}.ds-live{background:#F2A900;color:#14171C;animation:ds-pulse 1.6s ease-in-out infinite}@keyframes ds-pulse{0%,100%{opacity:.65}50%{opacity:1}}.ds-bb{border:0;border-radius:8px;padding:6px 12px;font:600 14px 'Golos Text',sans-serif;cursor:pointer}.ds-bb-sec{background:#EDEEF0;color:#16181D}.ds-bb-stop{background:#EDEEF0;color:#D13438}.ds-bb:hover{opacity:.88}.ds-bb:focus-visible{outline:2px solid #16181D;outline-offset:2px}"
